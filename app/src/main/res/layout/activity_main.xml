<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <androidx.camera.view.PreviewView android:id="@+id/previewView" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/modeSelector" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <View android:id="@+id/focusRing" android:layout_width="70dp" android:layout_height="70dp" android:background="@drawable/focus_ring_bg" android:visibility="gone" android:clickable="false" android:focusable="false" app:layout_constraintTop_toTopOf="@id/previewView" app:layout_constraintBottom_toBottomOf="@id/previewView" app:layout_constraintStart_toStartOf="@id/previewView" app:layout_constraintEnd_toEndOf="@id/previewView" />
    <View android:id="@+id/shutterFlash" android:layout_width="0dp" android:layout_height="0dp" android:background="#FFFFFF" android:alpha="0" android:clickable="false" android:focusable="false" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" app:layout_constraintTop_toTopOf="parent">
        <TextView android:id="@+id/flashPill" android:text="⚡ AUTO" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:background="#4D000000" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ImageView android:id="@+id/gearPill" android:src="@drawable/ic_gear" app:tint="#FFFFFF" android:background="#4D000000" android:padding="8dp" android:clickable="true" android:focusable="true" android:layout_width="34dp" android:layout_height="34dp" />
    </LinearLayout>
    <HorizontalScrollView android:id="@+id/modeSelector" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" app:layout_constraintBottom_toTopOf="@id/controlsRow">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="12dp" android:layout_gravity="center">
            <TextView android:id="@+id/mTime" android:text="TIME-LAPSE" android:textColor="#99FFFFFF" android:textSize="13sp" android:textStyle="bold" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/mSlo" android:text="SLO-MO" android:textColor="#99FFFFFF" android:textSize="13sp" android:textStyle="bold" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/mVideo" android:text="VIDEO" android:textColor="#99FFFFFF" android:textSize="13sp" android:textStyle="bold" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/mPhoto" android:text="PHOTO" android:textColor="#FFD60A" android:textSize="15sp" android:textStyle="bold" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/mPortrait" android:text="PORTRAIT" android:textColor="#99FFFFFF" android:textSize="13sp" android:textStyle="bold" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/mPano" android:text="PANORAMA" android:textColor="#99FFFFFF" android:textSize="13sp" android:textStyle="bold" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout android:id="@+id/controlsRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="32dp" android:paddingBottom="40dp" app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/zoomHalf" android:text="0.5x" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:background="#4D000000" android:padding="10dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/zoomOne" android:text="1x" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" android:background="#FFD60A" android:padding="10dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/zoomThree" android:text="3x" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:background="#4D000000" android:padding="10dp" android:clickable="true" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <ImageButton android:id="@+id/shutterBtn" android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/shutter_bg" android:contentDescription="Shutter" />
        <ImageButton android:id="@+id/switchBtn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:background="#4DFFFFFF" android:src="@android:drawable/ic_menu_rotate" android:contentDescription="Switch Camera" app:tint="#FFFFFF" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
